             <property name="styleSheet">
              <string notr="true">/* ==== QDateEdit ==== */
QDateEdit {
    background-color: #ffffff;
    border: 1px solid #c0c4c8;
    border-radius: 4px;
    padding: 4px 30px 4px 8px; /* chừa chỗ cho nút mũi tên */
    min-height: 24px;
    /* font sẽ kế thừa từ thiết lập chung */

}

/* Hover viền xám đậm hơn */
QDateEdit:hover {
    border: 1px solid #a0a4a8;
}

/* Focus viền xanh */
QDateEdit:focus {
    border: 1px solid #4a90e2;
}

/* ==== Popup Calendar ==== */
QCalendarWidget {
    background-color: #ffffff;
    border: 1px solid #c0c4c8;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #cce4f7;
    selection-color: #000000;
}

/* Header tháng */
QCalendarWidget QToolButton {
    background-color: transparent;
    border: none;
    font-weight: bold;
    color: #333333;
}

/* Tuần, ngày... */
QCalendarWidget QAbstractItemView:enabled {
    color: #2d2d2d;
    selection-background-color: #cce4f7;
    selection-color: #000;
}

/* Ngày khi hover */
QCalendarWidget QAbstractItemView::item:hover {
    background-color: #e8f1fb;
}

/* Scrollbar trong lịch (nếu có) */
QCalendarWidget QScrollBar:vertical {
    background: transparent;
    width: 8px;
}
QCalendarWidget QScrollBar::handle:vertical {
    background: #c0c4c8;
    min-height: 20px;
    border-radius: 4px;
}
QCalendarWidget QScrollBar::add-line,
QCalendarWidget QScrollBar::sub-line {
    height: 0;
}
</string>
