        <property name="styleSheet">
         <string notr="true">/* ==== CHUNG CHO CÁC TEXT INPUT / TEXT EDIT ==== */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #c0c4c8;      /* viền xám nhạt */
    border-radius: 4px;             /* bo góc mềm */
    padding: 4px 6px;               /* khoảng đệm bên trong */
    selection-background-color: #cce4f7;
    selection-color: #000;

}

/* Khi focus chuyển viền sang xanh */
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #4a90e2;
}

/* Placeholder màu nhạt (chỉ với QLineEdit) */
QLineEdit[placeholderText] {
    color: #999999;
}

/* ReadOnly thì nền hơi xám */
QLineEdit[readOnly=&quot;true&quot;],
QTextEdit[readOnly=&quot;true&quot;] {
    background-color: #f0f2f5;
}

/* Thanh cuộn bên trong QTextEdit bo góc &amp; nhỏ gọn */
QTextEdit QScrollBar:vertical,
QPlainTextEdit QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QTextEdit QScrollBar::handle:vertical,
QPlainTextEdit QScrollBar::handle:vertical {
    background: #c0c4c8;
    min-height: 20px;
    border-radius: 4px;
}
QTextEdit QScrollBar::add-line, QTextEdit QScrollBar::sub-line,
QPlainTextEdit QScrollBar::add-line, QPlainTextEdit QScrollBar::sub-line {
    height: 0;
}
</string>
        </property>
        <property name="placeholderText">
         <string>C:\Users\...\AppData\Local\Google\Chrome\User Data\Default</string>
        </property>
       </widget>
