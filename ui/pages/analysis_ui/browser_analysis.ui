    padding: 6px 12px;
    color: #000; /* chữ màu đen hoặc xám đậm */
}

QPushButton:hover {
    background-color: #d5d5d5; /* sáng hơn 1 chút khi hover */
}

QPushButton:pressed {
    background-color: #c0c0c0; /* tối hơn khi nhấn */
}
</string>
