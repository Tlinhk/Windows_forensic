   <item row="1" column="0">
    <layout class="QHBoxLayout" name="horizontalLayout_5">
     <item>
      <widget class="QWidget" name="widget" native="true">
       <property name="maximumSize">
        <size>
         <width>350</width>
         <height>16777215</height>
        </size>
       </property>
       <layout class="QGridLayout" name="gridLayout_2">
        <item row="0" column="0">
         <widget class="QTreeWidget" name="treeWidget">
          <property name="styleSheet">
           <string notr="true">/* ==== QTreeWidget / QTreeView ==== */
QTreeWidget,
QTreeView {
    background-color: #ffffff;             /* nền trắng */
    border: 1px solid #c0c4c8;             /* viền ngoài */
    border-radius: 6px;
    alternate-background-color: #f9fbfc;   /* màu hàng xen kẽ */
    show-decoration-selected: 1;           /* highlight toàn dòng khi chọn */
    selection-background-color: #cce4f7;
    selection-color: #000000;
}

/* Màu cho item xen kẽ */
QTreeWidget::item:alternate,
QTreeView::item:alternate {
    background-color: #f9fbfc;
}

/* Hover item */
QTreeWidget::item:hover,
QTreeView::item:hover {
    background-color: #e8f1fb;
}

/* Focus item */
QTreeWidget::item:focus,
QTreeView::item:focus {
    outline: none;
}

/* Selected item có viền nhẹ */
QTreeWidget::item:selected:active,
QTreeView::item:selected:active {
    border: 1px solid #4a90e2;
}

/* ==== Header của Tree ==== */
QTreeView::header,
QHeaderView::section {
    background-color: #e1e5ea;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #c0c4c8;
    border-right: 1px solid #c0c4c8;
    font-weight: bold;
}

/* Hover cho header */
QHeaderView::section:hover {
    background-color: #d7dae0;
}

/* Bỏ viền cuối của cột cuối cùng */
QHeaderView::section:last {
    border-right: none;
}

/* ==== Scrollbar cho Tree ==== */
QTreeWidget QScrollBar:vertical,
QTreeView QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
