              <string notr="true">/* ==== CHUNG CHO CÁC TEXT INPUT / TEXT EDIT ==== */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #c0c4c8;      /* viền xám nhạt */
    border-radius: 4px;             /* bo góc mềm */
    padding: 4px 6px;               /* khoảng đệm bên trong */
    selection-background-color: #cce4f7;
    selection-color: #000;
}

/* Khi focus chuyển viền sang xanh */
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #4a90e2;
}


/* ReadOnly thì nền hơi xám */
QLineEdit[readOnly=&quot;true&quot;],
QTextEdit[readOnly=&quot;true&quot;] {
    background-color: #f0f2f5;
}

