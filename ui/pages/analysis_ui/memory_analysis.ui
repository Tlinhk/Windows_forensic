               <property name="styleSheet">
                <string notr="true">/* ==== QSpinBox &amp; QDoubleSpinBox ==== */
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #c0c4c8;
    border-radius: 4px;
    min-height: 24px;
    padding: 2px 6px;            /* chừa khoảng cho text */
    font-family: &quot;Segoe UI&quot;;     /* kế thừa font chung */
}

/* Khi hover thì viền đậm lên */
QSpinBox:hover,
QDoubleSpinBox:hover {
    border: 1px solid #a0a4a8;
}

/* Khi focus (đang nhập/xoay số) đổi sang xanh */
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #4a90e2;
}




/* Xoá highlight nền của subcontrol khi disabled */
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #f0f2f5;
    color: #999;
}
</string>
