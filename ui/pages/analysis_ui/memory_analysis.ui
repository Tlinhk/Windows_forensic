                <string notr="true">/* QPushButton */
QPushButton {
    background-color: #4a90e2;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    color: #fff;
}
QPushButton:hover {
    background-color: #5aa0f2;
}
QPushButton:pressed {
    background-color: #3a7fcc;
}</string>
