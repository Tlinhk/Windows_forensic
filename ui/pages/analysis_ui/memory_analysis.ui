       </attribute>
       <layout class="QGridLayout" name="gridLayout_2">
        <item row="0" column="0">
         <widget class="QGroupBox" name="volatilityOptionsGroup">
          <property name="font">
           <font>
            <pointsize>8</pointsize>
            <weight>75</weight>
            <bold>true</bold>
           </font>
          </property>
          <property name="styleSheet">
           <string notr="true">QGroupBox {
    border: 1px solid #c0c4c8;
    border-radius: 6px;
    margin-top: 12px;
    padding: 8px;
}
</string>
          </property>
          <property name="title">
           <string>Volatility Options</string>
          </property>
          <layout class="QVBoxLayout" name="volatilityOptionsVBox">
           <property name="spacing">
            <number>5</number>
           </property>
           <property name="leftMargin">
            <number>0</number>
           </property>
           <property name="topMargin">
            <number>11</number>
           </property>
           <property name="rightMargin">
            <number>0</number>
           </property>
           <property name="bottomMargin">
            <number>0</number>
           </property>
           <item>
            <widget class="QLineEdit" name="pluginSearchEdit">
             <property name="font">
              <font>
               <pointsize>8</pointsize>
               <weight>50</weight>
               <bold>false</bold>
              </font>
             </property>
             <property name="styleSheet">
              <string notr="true">/* ==== CHUNG CHO CÁC TEXT INPUT / TEXT EDIT ==== */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #c0c4c8;      /* viền xám nhạt */
    border-radius: 4px;             /* bo góc mềm */
    padding: 4px 6px;               /* khoảng đệm bên trong */
    selection-background-color: #cce4f7;
    selection-color: #000;
}

/* Khi focus chuyển viền sang xanh */
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #4a90e2;
}

/* Placeholder màu nhạt (chỉ với QLineEdit) */
QLineEdit[placeholderText] {
    color: #999999;
}

/* ReadOnly thì nền hơi xám */
QLineEdit[readOnly=&quot;true&quot;],
QTextEdit[readOnly=&quot;true&quot;] {
    background-color: #f0f2f5;
}

/* Thanh cuộn bên trong QTextEdit bo góc &amp; nhỏ gọn */
QTextEdit QScrollBar:vertical,
QPlainTextEdit QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QTextEdit QScrollBar::handle:vertical,
QPlainTextEdit QScrollBar::handle:vertical {
    background: #c0c4c8;
    min-height: 20px;
    border-radius: 4px;
}
QTextEdit QScrollBar::add-line, QTextEdit QScrollBar::sub-line,
QPlainTextEdit QScrollBar::add-line, QPlainTextEdit QScrollBar::sub-line {
    height: 0;
}
</string>
             </property>
             <property name="placeholderText">
              <string>Search plugin...</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QTableWidget" name="pluginTableWidget">
             <property name="font">
              <font>
               <pointsize>8</pointsize>
              </font>
             </property>
             <property name="styleSheet">
              <string notr="true">/* ==== QTableWidget / QTableView ==== */
QTableWidget,
QTableView {
    background-color: #ffffff;           /* nền trắng */
    border: 1px solid #c0c4c8;           /* viền xám nhạt */
    gridline-color: #e0e3e6;             /* màu lưới */
    border-radius: 6px;                  /* bo góc toàn widget */
    selection-background-color: #cce4f7; /* màu nền khi chọn */
    selection-color: #000000;            /* màu chữ khi chọn */
}

/* Alternating row colors */
QTableWidget {
    alternate-background-color: #f9fbfc;
}
QTableWidget::item:alternate,
QTableView::item:alternate {
    background-color: #f9fbfc;
}

/* Header (cột và hàng) */
QHeaderView::section {
    background-color: #e1e5ea;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #c0c4c8;
    border-right: 1px solid #c0c4c8;
    font-weight: bold;
}
QHeaderView::section:last,
QHeaderView::section:last {
    border-right: none;
}

/* Cell hover */
QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #e8f1fb;
}

/* Remove focus rectangle */
QTableWidget::item:focus,
QTableView::item:focus {
    outline: none;
}

/* Scrollbar trong table */
QTableWidget QScrollBar:vertical,
QTableView QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QTableWidget QScrollBar::handle:vertical,
QTableView QScrollBar::handle:vertical {
    background: #c0c4c8;
    min-height: 20px;
    border-radius: 4px;
}
QTableWidget QScrollBar::add-line,
QTableWidget QScrollBar::sub-line,
QTableView QScrollBar::add-line,
QTableView QScrollBar::sub-line {
    height: 0;
}

/* Focused cell viền xanh nhẹ */
QTableWidget::item:selected:active,
QTableView::item:selected:active {
    border: 1px solid #4a90e2;
}

/* Header hover (nếu muốn) */
QHeaderView::section:hover {
    background-color: #d7dae0;
}
</string>
             </property>
             <property name="alternatingRowColors">
              <bool>true</bool>
             </property>
             <property name="selectionBehavior">
              <enum>QAbstractItemView::SelectRows</enum>
             </property>
             <property name="columnCount">
              <number>4</number>
             </property>
             <column>
              <property name="text">
               <string>Chọn</string>
              </property>
             </column>
             <column>
              <property name="text">
               <string>Tên plugin</string>
              </property>
             </column>
             <column>
              <property name="text">
               <string>Loại</string>
              </property>
             </column>
             <column>
              <property name="text">
               <string>Mô tả</string>
              </property>
             </column>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item row="1" column="0">
         <layout class="QHBoxLayout" name="horizontalLayout">
          <item>
           <widget class="QGroupBox" name="outputOptionsGroup">
            <property name="minimumSize">
             <size>
              <width>0</width>
