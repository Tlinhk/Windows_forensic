               <property name="styleSheet">
                <string notr="true">/* ==== QComboBox ==== */
QComboBox {
    /* nền trắng, bo góc và viền xám nhạt giống QLineEdit */
    background-color: #ffffff;
    border: 1px solid #c0c4c8;
    border-radius: 4px;
    padding: 4px 30px 4px 8px; /* để chừa chỗ cho mũi tên */
    min-height: 24px;
    /* font đã định ở đầu styles.qss sẽ áp dụng */
}

/* Khi hover đổi nhẹ viền */
QComboBox:hover {
    border: 1px solid #a0a4a8;
}

/* Khi focus (đang chọn) đổi viền xanh */
QComboBox:focus {
    border: 1px solid #4a90e2;
}

/* Mũi tên xổ xuống */
QComboBox::down-arrow {
    image: url(:/icons/arrow-down.svg); /* bạn có thể thay bằng đường dẫn SVG của bạn */
    width: 12px;
    height: 12px;
}

/* Vị trí của mũi tên */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}

/* Popup list (QAbstractItemView) */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c0c4c8;
    border-radius: 4px;
    padding: 4px;
    outline: none;
    selection-background-color: #cce4f7;
    selection-color: #000;
}

/* Các item trong list khi hover */
QComboBox QAbstractItemView::item:hover {
    background-color: #e8f1fb;
}

/* Scrollbar nhỏ gọn trong popup */
QComboBox QAbstractItemView QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QComboBox QAbstractItemView QScrollBar::handle:vertical {
    background: #c0c4c8;
    min-height: 20px;
    border-radius: 4px;
}
QComboBox QAbstractItemView QScrollBar::add-line,
QComboBox QAbstractItemView QScrollBar::sub-line {
    height: 0;
}
</string>
               </property>
