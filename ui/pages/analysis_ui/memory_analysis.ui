   <string notr="true">background-color: #f8f9fa;

/* ==== QTableWidget / QTableView ==== */
QTableWidget,
QTableView {
    background-color: #ffffff;           /* nền trắng */
    border: 1px solid #c0c4c8;           /* viền xám nhạt */
    gridline-color: #e0e3e6;             /* màu lưới */
    border-radius: 6px;                  /* bo góc toàn widget */
    selection-background-color: #cce4f7; /* màu nền khi chọn */
    selection-color: #000000;            /* màu chữ khi chọn */
}

/* Alternating row colors */
QTableWidget {
    alternate-background-color: #f9fbfc;
}
QTableWidget::item:alternate,
QTableView::item:alternate {
    background-color: #f9fbfc;
}

/* Header (cột và hàng) */
QHeaderView::section {
    background-color: #e1e5ea;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #c0c4c8;
    border-right: 1px solid #c0c4c8;
    font-weight: bold;
}
QHeaderView::section:last,
QHeaderView::section:last {
    border-right: none;
}

/* Cell hover */
QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #e8f1fb;
}

/* Remove focus rectangle */
QTableWidget::item:focus,
QTableView::item:focus {
    outline: none;
}

/* Scrollbar trong table */
QTableWidget QScrollBar:vertical,
QTableView QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QTableWidget QScrollBar::handle:vertical,
QTableView QScrollBar::handle:vertical {
    background: #c0c4c8;
    min-height: 20px;
    border-radius: 4px;
}
QTableWidget QScrollBar::add-line,
QTableWidget QScrollBar::sub-line,
QTableView QScrollBar::add-line,
QTableView QScrollBar::sub-line {
    height: 0;
}

/* Focused cell viền xanh nhẹ */
QTableWidget::item:selected:active,
QTableView::item:selected:active {
    border: 1px solid #4a90e2;
}

/* Header hover (nếu muốn) */
QHeaderView::section:hover {
    background-color: #d7dae0;
}

</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">/* ==== QTableWidget / QTableView ==== */
QTableWidget,
QTableView {
    background-color: #ffffff;           /* nền trắng */
    border: 1px solid #c0c4c8;           /* viền xám nhạt */
    gridline-color: #e0e3e6;             /* màu lưới */
    border-radius: 6px;                  /* bo góc toàn widget */
    selection-background-color: #cce4f7; /* màu nền khi chọn */
    selection-color: #000000;            /* màu chữ khi chọn */
}

/* Alternating row colors */
QTableWidget {
    alternate-background-color: #f9fbfc;
}
QTableWidget::item:alternate,
QTableView::item:alternate {
    background-color: #f9fbfc;
}

/* Header (cột và hàng) */
QHeaderView::section {
    background-color: #e1e5ea;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #c0c4c8;
    border-right: 1px solid #c0c4c8;
    font-weight: bold;
}
QHeaderView::section:last,
QHeaderView::section:last {
    border-right: none;
}

/* Cell hover */
QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #e8f1fb;
}

/* Remove focus rectangle */
QTableWidget::item:focus,
QTableView::item:focus {
    outline: none;
}

/* Scrollbar trong table */
QTableWidget QScrollBar:vertical,
QTableView QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QTableWidget QScrollBar::handle:vertical,
QTableView QScrollBar::handle:vertical {
    background: #c0c4c8;
    min-height: 20px;
    border-radius: 4px;
}
QTableWidget QScrollBar::add-line,
QTableWidget QScrollBar::sub-line,
QTableView QScrollBar::add-line,
QTableView QScrollBar::sub-line {
    height: 0;
}

/* Focused cell viền xanh nhẹ */
QTableWidget::item:selected:active,
QTableView::item:selected:active {
    border: 1px solid #4a90e2;
}

/* Header hover (nếu muốn) */
QHeaderView::section:hover {
    background-color: #d7dae0;
}

/* QPushButton */
QPushButton {
    background-color: #4a90e2;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    color: #fff;
}
QPushButton:hover {
    background-color: #5aa0f2;
}
QPushButton:pressed {
    background-color: #3a7fcc;
}
/* ==== QComboBox ==== */
QComboBox {
    /* nền trắng, bo góc và viền xám nhạt giống QLineEdit */
    background-color: #ffffff;
    border: 1px solid #c0c4c8;
    border-radius: 4px;
    padding: 4px 30px 4px 8px; /* để chừa chỗ cho mũi tên */
    min-height: 24px;
    /* font đã định ở đầu styles.qss sẽ áp dụng */
}

/* Khi hover đổi nhẹ viền */
QComboBox:hover {
    border: 1px solid #a0a4a8;
}

/* Khi focus (đang chọn) đổi viền xanh */
QComboBox:focus {
    border: 1px solid #4a90e2;
}

/* Popup list (QAbstractItemView) */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c0c4c8;
    border-radius: 4px;
    padding: 4px;
    outline: none;
    selection-background-color: #cce4f7;
    selection-color: #000;
}

/* Các item trong list khi hover */
QComboBox QAbstractItemView::item:hover {
    background-color: #e8f1fb;
}

/* Scrollbar nhỏ gọn trong popup */
QComboBox QAbstractItemView QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QComboBox QAbstractItemView QScrollBar::handle:vertical {
    background: #c0c4c8;
    min-height: 20px;
    border-radius: 4px;
}
QComboBox QAbstractItemView QScrollBar::add-line,
QComboBox QAbstractItemView QScrollBar::sub-line {
    height: 0;
}
</string>
